@model IEnumerable<CalmSpire.Models.GratitudeEntry>

@{
    ViewData["Title"] = "My Gratitude Journal";
}

<h2 class="mb-4">My Gratitude Journal</h2>

<a class="btn btn-success mb-3" asp-action="Create">+ Add New</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Content</th>
            <th>Created At</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in Model)
        {
            <tr>
                <td>@entry.Content</td>
                <td>@entry.CreatedAt.ToString("g")</td>
                <td>
                    <a class="btn btn-danger btn-sm" asp-action="Delete" asp-route-id="@entry.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
