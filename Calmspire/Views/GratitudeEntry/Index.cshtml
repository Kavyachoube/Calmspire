@model IEnumerable<CalmSpire.Models.GratitudeEntry>

<h3>My Gratitude Journal</h3>

<form asp-action="Create" method="post" class="mb-3">
    <div class="input-group">
        <input type="text" name="content" class="form-control" placeholder="Write something you are grateful for..." required />
        <button class="btn btn-success" type="submit">Add</button>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted">No entries yet.</p>
}
else
{
    <ul class="list-group">
        @foreach (var e in Model)
        {
            <li class="list-group-item">
                <div class="small text-muted">@e.CreatedAt.ToLocalTime().ToString("g")</div>
                <div>@e.Content</div>
            </li>
        }
    </ul>
}
