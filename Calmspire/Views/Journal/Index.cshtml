@model List<CalmSpire.Services.Article>

@{
    ViewData["Title"] = "Journals & Stories";
}

<h2 class="mb-4">Journals, Blogs & Stories</h2>

@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var article in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card shadow-sm h-100">
                    @if (!string.IsNullOrEmpty(article.UrlToImage))
                    {
                        <img src="@article.UrlToImage" class="card-img-top" alt="News Image" />
                    }
                    <div class="card-body">
                        <h5 class="card-title">@article.Title</h5>
                        <p class="card-text">@article.Description</p>
                        <a href="@article.Url" target="_blank" class="btn btn-primary">Read More</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>No articles found.</p>
}
