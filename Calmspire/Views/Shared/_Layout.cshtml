@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var userId = HttpContextAccessor.HttpContext.Session.GetInt32("UserId");
    var userName = HttpContextAccessor.HttpContext.Session.GetString("UserName");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CalmSpire</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary" href="@Url.Action("Index","Home")">CalmSpire</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (userId.HasValue)
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Dashboard")">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Mood")">Mood</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Journal")">Journal</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","GratitudeEntry")">Gratitude</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Assessment")">Assessments</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Chat")">Chat</a></li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-link nav-link text-danger">Logout</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Index","Home")">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="@Url.Action("Login","Account")">Login</a></li>
                        <li class="nav-item"><a class="btn btn-primary ms-2" href="@Url.Action("Register","Account")">Get Started</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="pb-5">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="text-center py-4 border-top">
        <p class="mb-0">© 2025 CalmSpire | Built with ❤️ for mental well-being</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
