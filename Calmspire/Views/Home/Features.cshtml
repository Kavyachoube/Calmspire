@{
    ViewData["Title"] = "Features";
}

<div class="features-hero py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="display-4 fw-bold mb-4">Comprehensive Mental Wellness Tools</h1>
                <p class="lead">
                    Discover how CalmSpire's integrated features work together to support
                    your mental health journey with evidence-based tools and personalized insights.
                </p>
            </div>
        </div>
    </div>
</div>

<div class="features-detailed py-5">
    <div class="container">
        <div class="feature-section mb-5">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <div class="feature-content">
                        <div class="feature-badge">
                            <i class="fas fa-chart-line"></i>
                        </div>
                        <h3>Visual Mood Tracking</h3>
                        <p class="lead">
                            Track your emotional patterns with our intuitive mood logging system.
                            Rate your mood from 1-10 daily and visualize trends with beautiful charts.
                        </p>
                        <ul class="feature-list">
                            <li><i class="fas fa-check text-success"></i> Daily mood entries with notes</li>
                            <li><i class="fas fa-check text-success"></i> 7-day trend visualization</li>
                            <li><i class="fas fa-check text-success"></i> Historical mood analysis</li>
                            <li><i class="fas fa-check text-success"></i> Pattern recognition insights</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="feature-image">
                        <img src="https://images.pexels.com/photos/590022/pexels-photo-590022.jpeg?auto=compress&cs=tinysrgb&w=800"
                             alt="Person looking at charts and analytics"
                             class="img-fluid rounded-3 shadow">
                    </div>
                </div>
            </div>
        </div>

        <div class="feature-section mb-5">
            <div class="row align-items-center">
                <div class="col-lg-6 order-lg-2">
                    <div class="feature-content">
                        <div class="feature-badge">
                            <i class="fas fa-journal-whills"></i>
                        </div>
                        <h3>Private Digital Journal</h3>
                        <p class="lead">
                            Express your thoughts and feelings in a secure, private space.
                            Research shows journaling can reduce stress and improve mental clarity.
                        </p>
                        <ul class="feature-list">
                            <li><i class="fas fa-check text-success"></i> Unlimited private entries</li>
                            <li><i class="fas fa-check text-success"></i> Rich text formatting</li>
                            <li><i class="fas fa-check text-success"></i> Search and organize entries</li>
                            <li><i class="fas fa-check text-success"></i> Export your reflections</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6 order-lg-1">
                    <div class="feature-image">
                        <img src="https://images.pexels.com/photos/261763/pexels-photo-261763.jpeg?auto=compress&cs=tinysrgb&w=800"
                             alt="Person writing in a journal"
                             class="img-fluid rounded-3 shadow">
                    </div>
                </div>
            </div>
        </div>

        <div class="feature-section mb-5">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <div class="feature-content">
                        <div class="feature-badge">
                            <i class="fas fa-spa"></i>
                        </div>
                        <h3>Curated Meditation Library</h3>
                        <p class="lead">
                            Access a carefully selected collection of meditation resources,
                            including guided meditations, breathing exercises, and mindfulness practices.
                        </p>
                        <ul class="feature-list">
                            <li><i class="fas fa-check text-success"></i> Guided meditation videos</li>
                            <li><i class="fas fa-check text-success"></i> Audio-only sessions</li>
                            <li><i class="fas fa-check text-success"></i> Breathing exercises</li>
                            <li><i class="fas fa-check text-success"></i> Progressive muscle relaxation</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="feature-image">
                        <img src="https://images.pexels.com/photos/3760067/pexels-photo-3760067.jpeg?auto=compress&cs=tinysrgb&w=800"
                             alt="Person meditating peacefully"
                             class="img-fluid rounded-3 shadow">
                    </div>
                </div>
            </div>
        </div>

        <div class="feature-section mb-5">
            <div class="row align-items-center">
                <div class="col-lg-6 order-lg-2">
                    <div class="feature-content">
                        <div class="feature-badge">
                            <i class="fas fa-robot"></i>
                        </div>
                        <h3>AI-Powered Support Chat</h3>
                        <p class="lead">
                            Get instant support from our empathetic AI assistant, available 24/7
                            to provide guidance, coping strategies, and a listening ear.
                        </p>
                        <ul class="feature-list">
                            <li><i class="fas fa-check text-success"></i> 24/7 availability</li>
                            <li><i class="fas fa-check text-success"></i> Empathetic responses</li>
                            <li><i class="fas fa-check text-success"></i> Coping strategy suggestions</li>
                            <li><i class="fas fa-check text-success"></i> Chat history saved</li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6 order-lg-1">
                    <div class="feature-image">
                        <img src="https://images.pexels.com/photos/8386440/pexels-photo-8386440.jpeg?auto=compress&cs=tinysrgb&w=800"
                             alt="Person using smartphone for mental health support"
                             class="img-fluid rounded-3 shadow">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="cta-section py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto text-center">
                <h2 class="cta-title">Start Your Wellness Journey Today</h2>
                <p class="cta-subtitle">
                    Experience the power of integrated mental health tools.
                    Join our community and take the first step toward better mental wellness.
                </p>
                <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-lg">
                    Get Started Free
                </a>
                <p class="mt-3 text-muted small">
                    No credit card required. Your privacy is protected.
                </p>
            </div>
        </div>
    </div>
</div>