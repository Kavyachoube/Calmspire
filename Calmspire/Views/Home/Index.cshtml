@{
    ViewData["Title"] = "CalmSpire - Home";
}

<!-- Navbar -->


<!-- Hero Section -->
<section class="hero-section text-center">
    <div class="container">
        <div class="hero-content">
            <h1>Welcome to <span>CalmSpire</span></h1>
            <p>Your personal space for mindfulness, mood tracking, AI chat, and emotional well-being.</p>

            <div class="hero-buttons mt-4">
                <a href="/Account/Register" class="btn btn-light me-2">Get Started</a>
                <a href="/Account/Login" class="btn btn-outline-light">Login</a>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-preview">
    <div class="container text-center">
        <h2 class="section-title">Why Choose CalmSpire?</h2>
        <p class="section-subtitle">Smart tools designed to help you grow emotionally and mentally.</p>

        <div class="row mt-5">
            <div class="col-md-3 mb-4">
                <div class="feature-card h-100">
                    <div class="feature-icon"><i class="fas fa-smile"></i></div>
                    <h4>Mood Tracking</h4>
                    <p>Log your daily moods and discover long-term patterns for self-awareness.</p>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="feature-card h-100">
                    <div class="feature-icon"><i class="fas fa-book"></i></div>
                    <h4>Daily Journal</h4>
                    <p>Write and reflect daily, build gratitude habits, and boost positivity.</p>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="feature-card h-100">
                    <div class="feature-icon"><i class="fas fa-tasks"></i></div>
                    <h4>Assessments</h4>
                    <p>Take guided self-assessments for stress, anxiety, and personal growth.</p>
                </div>
            </div>

            <div class="col-md-3 mb-4">
                <div class="feature-card h-100">
                    <div class="feature-icon"><i class="fas fa-robot"></i></div>
                    <h4>AI Chat</h4>
                    <p>Talk with our AI-powered assistant for instant support and guidance anytime.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="cta-section text-center">
    <div class="container">
        <h2 class="cta-title">Start Your Wellness Journey Today</h2>
        <p class="cta-subtitle">Join CalmSpire and unlock all features including Mood Tracking, Journaling, and AI Chat.</p>
        <a href="/Account/Register" class="btn btn-light">Get Started Free</a>
    </div>
</section>

<!-- Footer -->

