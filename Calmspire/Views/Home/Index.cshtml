@{
    ViewData["Title"] = "Welcome - CalmSpire";
}

<div class="container mt-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold">Welcome to <span style="color:#007bff;">CalmSpire</span></h1>
        <p class="lead">Track mood, write journals, practice gratitude, meditate, chat with AI, and take assessments.</p>
    </div>

    <div class="row g-4">

        <!-- Mood Tracker -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 text-center p-3">
                <div class="card-body">
                    <div class="mb-3">
                        <span class="fs-1">😊</span>
                    </div>
                    <h4 class="card-title">Mood Tracking</h4>
                    <p class="card-text">Track daily emotions and view patterns.</p>
                    <a href="/Mood" class="btn btn-primary">Log Mood</a>
                </div>
            </div>
        </div>

        <!-- Gratitude -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 text-center p-3">
                <div class="card-body">
                    <div class="mb-3">
                        <span class="fs-1">🙏</span>
                    </div>
                    <h4 class="card-title">Gratitude</h4>
                    <p class="card-text">Write your gratitude notes and reflections.</p>
                    <a href="/GratitudeEntry" class="btn btn-success">Open Gratitude</a>
                </div>
            </div>
        </div>

        <!-- Journaling (Articles/Stories) -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 text-center p-3">
                <div class="card-body">
                    <div class="mb-3">
                        <span class="fs-1">📖</span>
                    </div>
                    <h4 class="card-title">Journaling</h4>
                    <p class="card-text">Read blogs, stories, and articles for growth.</p>
                    <a href="/Journal" class="btn btn-info text-white">Explore Articles</a>
                </div>
            </div>
        </div>

        <!-- Meditation -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 text-center p-3">
                <div class="card-body">
                    <div class="mb-3">
                        <span class="fs-1">🧘</span>
                    </div>
                    <h4 class="card-title">Meditation</h4>
                    <p class="card-text">Relax with guided meditations and breathing.</p>
                    <a href="/Meditation" class="btn btn-warning text-dark">Start Meditation</a>
                </div>
            </div>
        </div>

        <!-- Assessments -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 text-center p-3">
                <div class="card-body">
                    <div class="mb-3">
                        <span class="fs-1">📝</span>
                    </div>
                    <h4 class="card-title">Assessments</h4>
                    <p class="card-text">Take self-assessments to check your progress.</p>
                    <a href="/Assessment" class="btn btn-primary">Take Assessment</a>
                </div>
            </div>
        </div>

        <!-- Chat -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 text-center p-3">
                <div class="card-body">
                    <div class="mb-3">
                        <span class="fs-1">💬</span>
                    </div>
                    <h4 class="card-title">Chat</h4>
                    <p class="card-text">Talk with AI assistant and get guidance.</p>
                    <a href="/Chat" class="btn btn-secondary">Open Chat</a>
                </div>
            </div>
        </div>

    </div>
</div>
