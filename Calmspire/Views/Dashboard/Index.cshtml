@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <h2 class="mb-4">Welcome back 👋</h2>
    <p class="lead">Here’s a quick overview of your Calmspire journey.</p>

    <div class="row g-4 mt-3">

        <div class="col-md-4">
            <div class="card shadow-sm h-100 text-center p-3">
                <h5>Mood Tracker</h5>
                <p>Track your emotions daily.</p>
                <a href="/Mood" class="btn btn-outline-primary">Go</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 text-center p-3">
                <h5>Gratitude Journal</h5>
                <p>Write what you’re grateful for.</p>
                <a href="/GratitudeEntry" class="btn btn-outline-success">Go</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 text-center p-3">
                <h5>Meditation</h5>
                <p>Relax with guided audios.</p>
                <a href="/Meditation" class="btn btn-outline-info">Go</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 text-center p-3">
                <h5>Articles & Stories</h5>
                <p>Read about mental wellness.</p>
                <a href="/Journal" class="btn btn-outline-warning">Go</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 text-center p-3">
                <h5>Assessments</h5>
                <p>Check your mental health insights.</p>
                <a href="/Assessment" class="btn btn-outline-dark">Go</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 text-center p-3">
                <h5>Chat Support</h5>
                <p>Talk with our AI/chatbot.</p>
                <a href="/Chat" class="btn btn-outline-secondary">Go</a>
            </div>
        </div>

    </div>
</div>
