@{
    ViewData["Title"] = "Dashboard";
    var moods = ViewBag.Moods as List<CalmSpire.Models.MoodEntry>;
    var journals = ViewBag.Journals as List<CalmSpire.Models.JournalEntry>;
}

<div class="container py-5">
    <h2 class="mb-4 text-center">🌿 Welcome to Your Wellness Dashboard</h2>

    <!-- Daily Suggestion -->
    <div class="card shadow p-4 mb-4" style="background:linear-gradient(135deg,#f0f9ff,#e0f2fe); border-radius:20px;">
        <h4>✨ Your Daily Suggestion</h4>
        <p style="font-size:1.2rem; line-height:1.6;">@ViewBag.Suggestion</p>
    </div>

    <div class="row g-4">
        <!-- Mood Tracker -->
        <div class="col-md-6">
            <div class="card shadow p-4 h-100">
                <h5 class="mb-3">📊 Your Mood (Last 7 Days)</h5>
                <canvas id="moodChart" height="200"></canvas>
            </div>
        </div>

        <!-- Gratitude -->
        <div class="col-md-6">
            <div class="card shadow p-4 h-100 text-center">
                <h5 class="mb-3">🙏 Gratitude Streak</h5>
                <p class="display-6">@ViewBag.GratitudeCount entries</p>
                <p>Keep writing small joys daily 🌸</p>
            </div>
        </div>
    </div>

    <!-- Journals -->
    <div class="card shadow p-4 my-4">
        <h5 class="mb-3">📖 Your Recent Journals</h5>
        <div class="list-group">
            @if (journals != null && journals.Any())
            {
                foreach (var j in journals)
                {
                    <a href="#" class="list-group-item list-group-item-action">
                        <h6 class="mb-1">@j.Title</h6>
                        <small>@j.CreatedAt.ToString("MMM dd, yyyy")</small>
                        <p class="mb-1">@j.Content.Substring(0, Math.Min(100, j.Content.Length))...</p>
                    </a>
                }
            }
            else
            {
                <p>No journals yet. Start writing your thoughts today ✍️</p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById('moodChart').getContext('2d');
        const data = {
            labels: [
        @foreach (var m in moods)
        {
            @: "@m.EntryDate.ToString("dd MMM")",
        }
                    ],
            datasets: [{
                label: 'Mood Score',
                data: [
        @foreach (var m in moods)
        {
            @: @m.MoodScore,
        }
                        ],
                fill: false,
                borderColor: 'rgb(75, 192, 192)',
                tension: 0.3
            }]
        };
        new Chart(ctx, { type: 'line', data: data });
    </script>
}
