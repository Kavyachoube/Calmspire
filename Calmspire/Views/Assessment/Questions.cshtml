@model CalmSpire.Models.ViewModels.AssessmentTakeViewModel
@{
    ViewData["Title"] = "Assessment Questions";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 p-5">
        <h3 class="fw-bold mb-4">@Model.Title</h3>
        <form method="post" asp-action="Submit" asp-controller="Assessment">
            <input type="hidden" name="AssessmentId" value="@Model.AssessmentId" />

            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var q = Model.Questions[i];
                <div class="mb-4">
                    <label class="fw-bold">@($"{i + 1}. {q.Question}")</label>
                    <div class="mt-2">
                        @foreach (var option in q.Options)
                        {
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="radio"
                                       name="q_@i"
                                       value="@option"
                                       required />
                                <label class="form-check-label">@option</label>
                            </div>
                        }
                    </div>
                </div>
                <hr />
            }

            <button type="submit" class="btn btn-primary btn-lg rounded-pill mt-3 px-5">
                Submit Assessment →
            </button>
        </form>
    </div>
</div>
