@model CalmSpire.Models.ViewModels.AssessmentTakeViewModel

<h2>@Model.Title</h2>
<p>@Model.Description</p>

<form asp-action="Submit" method="post">
    <input type="hidden" name="AssessmentId" value="@Model.AssessmentId" />

    @for (int i = 0; i < Model.Questions.Count; i++)
    {
        <div>
            <p><b>@Model.Questions[i].Question</b></p>
            @if (Model.Questions[i].Options.Any())
            {
                foreach (var opt in Model.Questions[i].Options)
                {
                    <label>
                        <input type="radio" name="q_@i" value="@opt" /> @opt
                    </label>

                    <br />
                }
            }
            else
            {
                <input type="text" name="q_@i" />
            }
        </div>
        <hr />
    }

    <button type="submit">Submit</button>
</form>
