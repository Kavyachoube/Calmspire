@model CalmSpire.Models.ViewModels.AssessmentTakeViewModel
@{
    ViewData["Title"] = "Assessment Questions";
}
<div class="container mt-4">
    <h3>@Model.Title</h3>
    <p class="text-muted">@Model.Description</p>

    <form method="post" asp-action="Submit" asp-controller="Assessment">
        <input type="hidden" name="AssessmentId" value="@Model.AssessmentId" />

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var q = Model.Questions[i];
            <div class="mb-4 p-3 border rounded shadow-sm">
                <h5>Q@(i + 1): @q.Question</h5>

                @if (q.Type == "radio")
                {
                    foreach (var opt in q.Options)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="q_@i" value="@opt" required />
                            <label class="form-check-label">@opt</label>
                        </div>
                    }
                }
                else if (q.Type == "checkbox")
                {
                    foreach (var opt in q.Options)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="q_@i" value="@opt" />
                            <label class="form-check-label">@opt</label>
                        </div>
                    }
                }
                else
                {
                    <input class="form-control" type="text" name="q_@i" placeholder="Your answer..." />
                }
            </div>
        }

        <button type="submit" class="btn btn-primary">Submit Assessment</button>
    </form>
</div>
