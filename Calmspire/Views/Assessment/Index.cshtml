@model IEnumerable<CalmSpire.Models.Assessment>
@{
    ViewData["Title"] = "Available Assessments";
}

<div class="container mt-5">
    <h2 class="text-center mb-4 fw-bold">🧠 Explore Mental Health Assessments</h2>
    <p class="text-center text-muted mb-5">
        Choose an assessment to better understand your emotions, stress, and well-being.
    </p>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow border-0 h-100 rounded-4">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold">@item.Title</h5>
                        <p class="card-text text-muted flex-grow-1">@item.Description</p>
                        <a class="btn btn-primary mt-3 rounded-pill"
                           href="@Url.Action("Start", "Assessment", new { id = item.Id })">
                            Start Assessment →
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
