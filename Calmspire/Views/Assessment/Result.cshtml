@model CalmSpire.Models.AssessmentResult
@{
    ViewData["Title"] = "Assessment Result";
    var history = ViewBag.History as List<CalmSpire.Models.AssessmentResult>;
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h3 class="card-title">Your Results</h3>
            <p><strong>Assessment:</strong> @Model.Assessment?.Title</p>
            <p><strong>Score:</strong> @Model.Score</p>
            <p><strong>Interpretation:</strong> @Model.Interpretation</p>
            <p class="text-muted">Completed on @Model.CompletedAt.ToLocalTime().ToString("f")</p>
        </div>
    </div>

    @if (history != null && history.Count > 1)
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h4 class="card-title">Your Previous Attempts</h4>
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Score</th>
                            <th>Interpretation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in history.Where(h => h.Id != Model.Id))
                        {
                            <tr>
                                <td>@item.CompletedAt.ToLocalTime().ToString("f")</td>
                                <td>@item.Score</td>
                                <td>@item.Interpretation</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <a class="btn btn-secondary mt-3" href="@Url.Action("Index", "Assessment")">Back to Assessments</a>
</div>
