@model CalmSpire.Models.AssessmentResult
@{
    ViewData["Title"] = "Your Assessment Result";
}

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-4 p-5 text-center">
        <h2 class="fw-bold mb-4">Your Result</h2>
        <p class="lead text-muted">
            You just completed: <strong>@Model.Assessment?.Title</strong>
        </p>

        <div class="alert alert-info rounded-4 mt-4">
            <h4 class="fw-bold">Score: @Model.Score</h4>
            <p>@Model.Interpretation</p>
        </div>

        <h5 class="mt-5">📜 Recent Attempts</h5>
        <ul class="list-group mt-3">
            @foreach (var past in (IEnumerable<CalmSpire.Models.AssessmentResult>)ViewBag.History)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@past.CompletedAt.ToString("MMM dd, yyyy HH:mm")</span>
                    <span class="badge bg-primary rounded-pill">Score: @past.Score</span>
                </li>
            }
        </ul>

        <div class="mt-4">
            <a href="@Url.Action("Index", "Assessment")" class="btn btn-outline-primary rounded-pill px-4">
                ← Back to Assessments
            </a>
            <a href="@Url.Action("Index", "Home")" class="btn btn-success rounded-pill px-4 ms-2">
                Go to Dashboard →
            </a>
        </div>
    </div>
</div>
