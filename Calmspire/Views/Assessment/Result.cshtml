@model CalmSpire.Models.AssessmentResult
@{
    var history = ViewBag.History as List<CalmSpire.Models.AssessmentResult>;
}

<h2>@Model.Assessment.Title - Your Result</h2>
<p><b>Score:</b> @Model.Score</p>
<p><b>Interpretation:</b> @Model.Interpretation</p>
<p><i>Completed at: @Model.CompletedAt</i></p>

<h3>Recent Attempts</h3>
@if (history != null && history.Any())
{
    <ul>
        @foreach (var h in history)
        {
            <li>Score: @h.Score - @h.CompletedAt</li>
        }
    </ul>
}
else
{
    <p>No past attempts.</p>
}
