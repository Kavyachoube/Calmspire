@model CalmSpire.Models.MoodEntry
@{
    ViewData["Title"] = "Edit Mood Entry";
}

<div class="container py-4">
    <h2>✏️ Edit Mood Entry</h2>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="MoodScore" class="form-label">Mood Score</label>
            <input asp-for="MoodScore" type="number" class="form-control" min="1" max="10" />
            <span asp-validation-for="MoodScore" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label">Notes</label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-success">Update</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
